{
  "name": "ngx-firebase-ai-logic",
  "private": true,
  "version": "0.1.0",
  "description": "Angular providers for Firebase AI Logic (Gemini) with App Check — DRY bootstrap for AI-powered apps",
  "license": "MIT",
  "author": "Wayne Gakuo",
  "repository": {
    "type": "git",
    "url": "https://github.com/waynegakuo/ngx-firebase-ai-logic.git"
  },
  "keywords": [
    "angular",
    "ngx",
    "firebase",
    "firebase-ai-logic",
    "gemini",
    "app-check",
    "generative-ai"
  ],
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies",
    "packages": [
      "firebase@^12.19.0"
    ]
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "watch": "ng-packagr -p ng-package.json --watch",
    "prepare-dist": "node scripts/prepare-dist-package.cjs",
    "pack:lib": "npm run build && npm run prepare-dist && npm pack ./dist/ngx-firebase-ai-logic",
    "publish:lib": "npm run build && npm run prepare-dist && npm publish ./dist/ngx-firebase-ai-logic --access public"
  },
  "peerDependencies": {
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "firebase": ">=12.19.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@schematics/angular": "^19.2.0",
    "firebase": "^12.19.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.7.2"
  }
}
